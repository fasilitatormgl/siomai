{
  "hosting": {
    "public": "_site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/baca/:slug*",
        "destination": "/baca.html?slug=:slug*",
        "type": 301
      }
    ]
  }
}
